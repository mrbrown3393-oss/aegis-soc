MONGO_URL=mongodb://localhost:27017
DB_NAME=aegis_soc
AEGIS_ENV=development
JWT_SECRET=change-me-to-a-64-char-hex-string
ADMIN_EMAIL=william.brown@aegis-soc.io
ADMIN_PASSWORD=change-me
ANALYST_EMAIL=analyst@aegis-soc.io
ANALYST_PASSWORD=change-me
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_METHODS=GET,POST,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Requested-With
MONGO_TLS=true
MONGO_TLS_CA_FILE=
MONGO_TLS_CERT_KEY_FILE=
MONGO_TLS_ALLOW_INVALID_CERTS=false
TRUSTED_PROXY_IPS=
EDGE_ENFORCE_DECISION=false
# EDGE_VERIFY_SECRET must be set in production when edge enforcement is enabled.
EDGE_AUDIENCE=aegis-api
EDGE_MAX_CLOCK_SKEW_SECONDS=30
EDGE_TRUSTED_CLIENT_IP_HEADER=X-Aegis-Edge-Client-IP
SSO_BASE_URL=http://localhost:8001
SAML_ENABLED=false
OIDC_ENABLED=false
SAML_IDP_ENTITY_ID=
SAML_IDP_SSO_URL=
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_REDIRECT_URI=http://localhost:8001/api/auth/sso/oidc/callback
OIDC_SUCCESS_REDIRECT_URL=http://localhost:3000
OIDC_TENANT_CLAIM=tenant
OIDC_ALLOWED_TENANTS=private
OIDC_ROLE_CLAIM=role
OIDC_REQUIRE_MFA_CLAIM=true
OIDC_MFA_AMR_VALUES=mfa

OIDC_ALLOW_EMAIL_LINKING=false
