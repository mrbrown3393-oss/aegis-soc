# Copy to .env and fill in. Never commit a real key.

PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-in-production

# xAI Grok API (optional)
# Get a key from https://console.x.ai
# If unset, Aegis uses the local Grok Analyst simulation.
XAI_API_KEY=
XAI_API_BASE=https://api.x.ai/v1
XAI_MODEL=grok-4
XAI_TIMEOUT_MS=25000
