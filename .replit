modules = ["python-3.11"]
run = "cd backend && uvicorn server:app --host 0.0.0.0 --port 8001"
hidden = [".config", ".git", "__pycache__", ".pytest_cache"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "cd backend && pip install -r requirements.txt"]
run = ["sh", "-c", "cd backend && uvicorn server:app --host 0.0.0.0 --port 8001"]

[[ports]]
localPort = 8001
externalPort = 80
